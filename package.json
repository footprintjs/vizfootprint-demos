{
  "name": "vizfootprint-demo",
  "version": "0.0.1",
  "private": true,
  "description": "vizfootprint on public data \u2014 CDC's NNDSS weekly notifiable-disease tables, reproduced as a provenance-first dashboard with the interaction grammar on screen.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:fetch": "node data/nndss/fetch.mjs",
    "serve": "tsx server/server.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc --noEmit -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:geo": "node data/geo/fetch.mjs"
  },
  "dependencies": {
    "agentfootprint": "^9.82.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vizfootprint": "file:../vizfootprint",
    "vizfootprint-ui": "file:../vizfootprint/ui"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.22.5",
    "typescript": "^5.5.0",
    "us-atlas": "^3.0.1",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
