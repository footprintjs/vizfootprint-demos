{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "server",
    "data/nndss/*.ts",
    "tests",
    "scripts"
  ]
}
